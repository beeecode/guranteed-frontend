# Safe default: design fixtures only. Also accepts "disabled".
GFMS_BFF_MODE=mock

# Authorized integration mode is server-only. Never prefix these with NEXT_PUBLIC_.
# Enable only for an owner-approved isolated environment after the repository
# integration preflight has confirmed its identity and write authorization.
# GFMS_BFF_MODE=integration
# GFMS_INTEGRATION_AUTHORIZATION=ISOLATED_NON_PRODUCTION_SUPABASE
# GFMS_INTEGRATION_ENVIRONMENT_ID=00000000-0000-4000-8000-000000000000
# GFMS_BACKEND_URL=http://127.0.0.1:5107
# GFMS_SESSION_SECRET=replace-with-at-least-32-random-characters
