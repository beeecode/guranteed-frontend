# Fail-closed default. Set "mock" explicitly only for visual fixture review.
GFMS_BFF_MODE=disabled

# Authorized integration mode is server-only. Never prefix these with NEXT_PUBLIC_.
# Enable only for an owner-approved isolated environment after the repository
# integration preflight has confirmed its identity and write authorization.
# GFMS_BFF_MODE=integration
# GFMS_INTEGRATION_AUTHORIZATION=ISOLATED_NON_PRODUCTION_SUPABASE
# GFMS_INTEGRATION_ENVIRONMENT_ID=00000000-0000-4000-8000-000000000000
# GFMS_BACKEND_URL=http://127.0.0.1:5107
# GFMS_SESSION_SECRET=replace-with-at-least-32-random-characters
# Stage 11: same value as BFF_SHARED_SECRET on the API (32+ chars). Lets the API apply
# login/form limits per visitor instead of to everyone behind this server.
# GFMS_BACKEND_SHARED_SECRET=replace-with-at-least-32-random-characters
# GFMS_SESSION_STORE=memory
# GFMS_ALLOW_LOCAL_SESSION_STORE=true
# Production/shared: GFMS_SESSION_STORE=external with an authenticated rediss:// URL.
# Plain redis:// is accepted only for loopback tests with the explicit local flag.
# GFMS_REDIS_URL=rediss://user:password@redis.example.invalid:6379/0
# GFMS_REDIS_PREFIX=gfms:session:
# GFMS_ALLOW_INSECURE_LOCAL_REDIS=true
